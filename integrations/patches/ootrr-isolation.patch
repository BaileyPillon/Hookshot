--- /dev/null
+++ b/src/oot_rando/longshot.py
@@ -0,0 +1,16 @@
+"""Bound Longshot's optional companion to its separate mode installation."""
+import os
+from pathlib import Path
+
+
+def allowed_process(image):
+    game = os.environ.get('LONGSHOT_OOTRR_GAME')
+    if not game:
+        return True
+    return bool(image) and Path(image).resolve() == (Path(game) / 'hookshot.exe').resolve()
+
+
+def validate_mod_target(directory):
+    game = os.environ.get('LONGSHOT_OOTRR_GAME')
+    if game and Path(directory).resolve() != (Path(game) / 'mods').resolve():
+        raise ValueError('Longshot installs these seeds only in its separate full-randomizer game folder.')
